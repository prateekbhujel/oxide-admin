# ==============================================================================
# OxideAdmin cPanel & Shared Hosting Reverse Proxy Configuration
# ==============================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Direct access to real existing static files (css, js, images, favicon)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Native mod_proxy forward (if mod_proxy is enabled on your host)
    <IfModule mod_proxy.c>
        RewriteRule ^(.*)$ http://127.0.0.1:3000/$1 [P,L]
        ProxyPassReverse / http://127.0.0.1:3000/
    </IfModule>

    # Fallback to PHP Supervisor & Streaming Reverse Proxy Bridge
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

# Security: Block direct web access to database and internal script files
<FilesMatch "\.(db|sqlite|sqlite3|env|sh|log|pid)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
